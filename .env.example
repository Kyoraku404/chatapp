# Server only — NEVER expose with NEXT_PUBLIC_ prefix
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
SESSION_COOKIE_NAME=rush_session
